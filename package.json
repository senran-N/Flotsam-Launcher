{
  "name": "flotsam-launcher",
  "private": true,
  "version": "0.0.1-pre",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "pwsh -NoProfile -File scripts/build-multiplayer.ps1 -Deploy && tauri build && node scripts/package.mjs",
    "plugin:build": "pwsh -NoProfile -File scripts/build-multiplayer.ps1 -Deploy",
    "multiplayer:build": "pwsh -NoProfile -File scripts/build-multiplayer.ps1 -Deploy",
    "multiplayer:test": "dotnet run --project multiplayer/Protocol.Tests -c Release",
    "lab": "pwsh -NoProfile -File scripts/prepare-multiplayer-lab.ps1 -Launch",
    "test": "playwright test",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "lucide-vue-next": "^0.468.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@playwright/test": "^1.56.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
