{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "浮游",
  "version": "0.0.1-pre",
  "identifier": "local.flotsam.launcher",
  "build": {"beforeDevCommand":"npm run dev","devUrl":"http://127.0.0.1:1420","beforeBuildCommand":"npm run build","frontendDist":"../dist"},
  "app": {
    "windows": [{"label":"main","title":"浮游 · Flotsam Launcher","width":1160,"height":740,"minWidth":900,"minHeight":620,"center":true,"decorations":false,"backgroundColor":"#1778AE"}],
    "security":{"csp":"default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost"}
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Flotsam Launcher Contributors",
    "shortDescription": "浮游 (Flotsam) 模组管理、存档守护与多船联机启动器",
    "icon": ["icons/icon.ico", "icons/icon.png"],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    }
  }
}
